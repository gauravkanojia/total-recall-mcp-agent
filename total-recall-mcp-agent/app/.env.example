APP_NAME=Total-Recall MCP Agent
APP_VERSION=0.1.0

ENVIRONMENT=development

HOST=0.0.0.0
PORT=4646

# postgresql://root@localhost:26257/defaultdb?sslmode=disable

# postgresql:// – CockroachDB is wire-compatible with PostgreSQL, so you use the Postgres driver prefix.
# root – The default admin user.
# localhost:26257 – The default local host and SQL port.
# defaultdb – The default database CockroachDB creates automatically.
# sslmode=disable – Tells the driver not to look for SSL certificates.
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:26257/mcpdb
# Your local CockroachDB is running with:
# --insecure
# so no SSL parameters are needed.
# DATABASE_URL=postgresql+asyncpg://root@localhost:26260/total_recall_mcp_db?sslmode=disable
DATABASE_URL=cockroachdb+asyncpg://root@localhost:26260/total_recall_mcp_db
DATABASE_NAME="total_recall_mcp_db"
DATABASE_ECHO=false

AWS_REGION=us-east-1

# HTTP transport auth (stdio is always unauthenticated local dev):
#   github — callers send "Authorization: Bearer <github token>"; validated
#            via api.github.com/user, principal becomes "github:<login>"
#   static — only MCP_STATIC_TOKENS accepted (offline demos)
#   off    — no auth; local development only
HTTP_AUTH_MODE=off
# Fallback/static tokens, comma-separated "token:principal-id" pairs:
# MCP_STATIC_TOKENS=demo-token-1:alice,demo-token-2:bob
MCP_STATIC_TOKENS=
GITHUB_API_URL=https://api.github.com
AUTH_CACHE_TTL_SECONDS=300

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

LOG_LEVEL=INFO
