{
  "mcpServers": {
    "cockroachdb-cloud": {
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "Authorization": "Bearer <COCKROACH_CLOUD_MCP_TOKEN>"
      }
    },
    "total-recall-mcp-agent": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "/absolute/path/to/cockroachdb-aws-hackathon-aug-2026/total-recall-mcp-agent",
        "total-recall-mcp-agent"
      ],
      "env": {
        "DATABASE_URL": "cockroachdb+asyncpg://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full",
        "DATABASE_NAME": "total_recall_mcp_db",
        "EMBEDDING_PROVIDER": "fake"
      }
    }
  }
}
